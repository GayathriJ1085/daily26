import java.util.*;
public class zero{
    public static void main(String []args){
        Scanner sc = new Scanner (System.in);
        int a = sc.nextInt();
        int arr[] = new int[a];

        for(int i =0; i<a; i++){
            arr[i] = sc.nextInt();
        }
        int j = 0;
        for(int i =0; i<a-1; i++){
            if (arr[i]!=0){
                int temp = arr[i];
                arr[j] = arr[i];
                temp = arr[j];
                j++;
            }
        }

        while (j<a){
            arr[j] = 0;
            j++;
        }
        for(int i =0; i<a; i++){
            System.out.print(arr[i] + " ");
        }
    }
}
