import java.util.Scanner;

public class reverse {
    public static void main(String []args){
        Scanner sc = new Scanner (System.in);
        int a = sc.nextInt();
        int arr[] = new int[a];

        for(int i =0; i<a; i++){
            arr[i] = sc.nextInt();
        }

        int s = 0;
        int e = a-1;

        while(s<e){
            int temp = arr[s];
            arr[s] = arr[e];
            arr[e] = temp;

            s++;
            e--;
        }

        for(int i =0; i<a; i++){
            System.out.print(arr[i]);
        }
    }

}
