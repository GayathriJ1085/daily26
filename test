import java.util.*;
public class test {
    public static void main(String[]args){
            Scanner sc = new Scanner (System.in);
            int a = sc.nextInt();
            int arr[]= new int[a];

            for(int i=0; i<a; i++){
                arr[i]=sc.nextInt();
            }
            int min = arr[0];
            int sum =0;
            int maxi =arr[0];
            for (int i =0; i<a;  i++){
                sum = sum + arr[i];
                if (arr[i]>maxi){
                    maxi = arr[i];
                }
                if (arr[i]<min){
                    min = arr[i];
                }
        }
        int avg = sum / a;
        System.out.println("sum = " + sum);
        System.out.println("avg = " + avg);
        System.out.println("minimum = " + min);
        System.out.println("maximum = " + maxi);
    }
}
