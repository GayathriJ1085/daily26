import java.util.Scanner;

public class sorted {
    public static void main(String []args){
        Scanner sc = new Scanner (System.in);
        int a = sc.nextInt();
        int arr[] = new int[a];

        for(int i =0; i<a; i++){
            arr[i] = sc.nextInt();
        }

        boolean y = true;
        for(int i =0; i<a-1; i++){
            if(arr[i]>arr[i+1]){
                y = false;
                break;
            }
        }
        if(y)
            {
                System.out.print("is sorted");
            }
        else{
                System.out.print("not sorted");
            }
    }
}
