import java.util.*;
public class couneo {
    public static void main(String [] args){
        Scanner sc = new Scanner(System.in);
        int a = sc.nextInt();
        int arr[] = new int [a];

        for (int i =0; i<a; i++){
            arr[i]= sc.nextInt();
        }

        int sume = 0;
        int sumo = 0;
        for (int i =0; i<a; i++){
            if (arr[i]%2 == 0){
                sume ++;
            }else{
                sumo++;
            }

        }
        System.out.println("even: "+sume);
        System.out.println("odd: "+sumo);
    }
}
